@article{HLI,
author = {McCune, Bruce and Keon, Dylan},
title = {Equations for potential annual direct incident radiation and heat load},
journal = {Journal of Vegetation Science},
volume = {13},
number = {4},
pages = {603-606},
keywords = {Aspect, Azimuth, Latitude, Light, Slope, Temperature, Topography},
doi = {https://doi.org/10.1111/j.1654-1103.2002.tb02087.x},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/j.1654-1103.2002.tb02087.x},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1111/j.1654-1103.2002.tb02087.x},
abstract = {Abstract. Estimation of potential annual direct incident radiation has traditionally required numerical integration with simulation models. As an alternative, we present convenient equations for use in spreadsheet, GIS, and database applications. Input variables are latitude, slope, and aspect. The equations apply to 0–60° north latitude, slopes from 0–90°, and all aspects. By transforming aspect, the equations can also be applied as an index of heat load, symmetrical about a northeast to southwest axis.},
year = {2002}
}

